# Threshold config — suppress noisy internet background noise
# to reduce alert volume on the public-facing VPS.
#
# Format:
#   suppress gen_id <gid>, sig_id <sid>
#   threshold gen_id <gid>, sig_id <sid>, type <limit|threshold|both>, track <by_src|by_dst|by_rule>, count <N>, seconds <T>

# ── Port scans ────────────────────────────────────────────────────────
# Port scan detectors generate enormous volume on public servers.
# Suppress after 5 occurrences in 60 seconds per source IP.
threshold gen_id 1, sig_id 100000001, type threshold, track by_src, count 5, seconds 60
threshold gen_id 1, sig_id 100000002, type threshold, track by_src, count 5, seconds 60

# ── Internet background noise (common SIDs from ETOpen) ──────────────
# ET SCAN - commonly seen scanner IPs
suppress gen_id 1, sig_id 2100494
