# ── Generic rate-limit: suppress the same SID from the same source
# after 10 times in 60 seconds. Catches scanner bursts generically.
threshold gen_id 1, sig_id 100000001, type threshold, track by_src, count 10, seconds 60
threshold gen_id 1, sig_id 100000002, type threshold, track by_src, count 10, seconds 60
