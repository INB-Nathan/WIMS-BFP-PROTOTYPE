PUBLIC_BASE_URL=https://example.com
LETSENCRYPT_DIR=/etc/letsencrypt

# Optional deployment metadata for scripts and logs.
APP_VERSION=replace-with-git-sha

# --- Ollama AI inference (GH #245) ---
# Ollama API base URL (default: http://ollama:11434 inside Docker network).
# OLLAMA_URL=http://ollama:11434
# Inference timeout in seconds (default: 120). CPU-only Qwen2.5-3B inference
# takes 30-120s. Set higher for low-resource deployments.
# OLLAMA_TIMEOUT=120

# Optional credentials/secrets should be supplied on the VPS only.
KEYCLOAK_ADMIN_CLIENT_ID=
KEYCLOAK_ADMIN_CLIENT_SECRET=
FIREBASE_CREDENTIALS_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=
