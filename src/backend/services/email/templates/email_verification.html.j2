{# subject: WIMS-BFP Email Verification Code #}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WIMS-BFP Email Verification</title>
</head>
<body style="margin:0;padding:0;background-color:#f4f4f4;font-family:Arial,sans-serif;">
  <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#f4f4f4;padding:24px 16px;">
    <tr>
      <td align="center">
        <table width="600" cellpadding="0" cellspacing="0" style="max-width:600px;width:100%;">
          <!-- Header -->
          <tr>
            <td style="background-color:#8B0000;padding:24px 32px;text-align:center;">
              <p style="margin:0;color:#ffffff;font-size:20px;font-weight:bold;">Bureau of Fire Protection</p>
              <p style="margin:4px 0 0;color:#ffcccc;font-size:14px;">WIMS-BFP Incident Management System</p>
            </td>
          </tr>

          <!-- Body -->
          <tr>
            <td style="background-color:#ffffff;padding:32px;">
              <p style="margin:0 0 16px;color:#333333;font-size:16px;line-height:1.5;">Hello {{ username }},</p>

              {% if verify_url %}
              <p style="margin:0 0 16px;color:#333333;font-size:16px;line-height:1.5;">
                Thanks for signing up for WIMS-BFP. Confirm your email address to finish
                creating your civilian reporter account:
              </p>

              <div style="background-color:#f8f8f8;border:1px solid #dddddd;padding:16px;text-align:center;margin:0 0 16px;">
                <span style="font-size:28px;font-weight:bold;letter-spacing:6px;color:#8B0000;">{{ code }}</span>
              </div>

              <p style="text-align:center;margin:0 0 16px;">
                <a href="{{ verify_url }}"
                   style="background-color:#8B0000;color:#ffffff;padding:12px 24px;border-radius:8px;text-decoration:none;font-weight:bold;display:inline-block;">
                  Verify my email
                </a>
              </p>

              <p style="margin:0 0 16px;color:#555555;font-size:14px;line-height:1.5;">
                This code expires in 10 minutes. If the button doesn't work, open the link
                or paste the code on the verification page.
              </p>
              {% else %}
              <p style="margin:0 0 16px;color:#333333;font-size:16px;line-height:1.5;">
                You have requested to change your WIMS-BFP login email address to <strong>{{ pending_email }}</strong>.
              </p>

              <p style="margin:0 0 16px;color:#333333;font-size:16px;line-height:1.5;">
                Please use the following verification code to confirm this change:
              </p>

              <div style="background-color:#f8f8f8;border:1px solid #dddddd;padding:16px;text-align:center;margin:0 0 16px;">
                <span style="font-size:28px;font-weight:bold;letter-spacing:6px;color:#8B0000;">{{ code }}</span>
              </div>

              <p style="margin:0 0 16px;color:#555555;font-size:14px;line-height:1.5;">
                This code expires in 10 minutes. If you did not request this change, please contact your system administrator immediately.
              </p>
              {% endif %}
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="background-color:#eeeeee;padding:16px 32px;text-align:center;">
              <p style="margin:0;color:#666666;font-size:12px;">
                This is an automated message from WIMS-BFP. Please do not reply to this email.
              </p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
