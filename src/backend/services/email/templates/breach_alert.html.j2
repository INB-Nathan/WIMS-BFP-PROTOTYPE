{# subject: [{{ severity|upper }}] WIMS-BFP Data Breach Detected — NPC 72h Window Open #}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WIMS-BFP Breach Notification</title>
</head>
<body style="margin:0;padding:0;background-color:#f4f4f4;font-family:Arial,sans-serif;">
  <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#f4f4f4;padding:24px 16px;">
    <tr>
      <td align="center">
        <table width="600" cellpadding="0" cellspacing="0" style="max-width:600px;width:100%;">
          <!-- Header -->
          <tr>
            <td style="background-color:#8B0000;padding:24px 32px;text-align:center;">
              <p style="margin:0;color:#ffffff;font-size:20px;font-weight:bold;">Bureau of Fire Protection</p>
              <p style="margin:4px 0 0;color:#ffcccc;font-size:14px;">WIMS-BFP Incident Management System</p>
            </td>
          </tr>
          <!-- Body -->
          <tr>
            <td style="background-color:#ffffff;padding:40px 32px;">
              <p style="margin:0 0 8px;font-size:12px;font-weight:bold;text-transform:uppercase;color:#8B0000;">Data Breach Notification</p>
              <p style="margin:0 0 8px;font-size:22px;font-weight:bold;color:#333333;">{{ summary }}</p>
              <table cellpadding="0" cellspacing="0" style="margin:0 0 24px;">
                <tr>
                  <td style="background-color:{% if severity|lower == 'critical' %}#8B0000{% elif severity|lower == 'high' %}#c0392b{% elif severity|lower == 'medium' %}#e67e22{% else %}#95a5a6{% endif %};border-radius:4px;padding:8px 16px;">
                    <span style="color:#ffffff;font-size:14px;font-weight:bold;">{{ severity|upper }} SEVERITY — BREACH #{{ breach_id }}</span>
                  </td>
                </tr>
              </table>
              <p style="margin:0 0 16px;font-size:16px;color:#333333;line-height:1.6;">
                A data breach has been confirmed in the WIMS-BFP system. As required under <strong>RA 10173 (Data Privacy Act)</strong>, the National Privacy Commission must be notified within <strong>72 hours</strong> of breach detection.
              </p>
              <table cellpadding="0" cellspacing="0" style="width:100%;margin:0 0 24px;border-collapse:collapse;">
                <tr>
                  <td style="padding:8px 0;font-size:15px;color:#333333;border-bottom:1px solid #eeeeee;">
                    <strong>Detected at:</strong> {{ detected_at }}
                  </td>
                </tr>
                <tr>
                  <td style="padding:8px 0;font-size:15px;color:#c0392b;border-bottom:1px solid #eeeeee;">
                    <strong>NPC Deadline:</strong> {{ npc_deadline }}
                  </td>
                </tr>
                <tr>
                  <td style="padding:8px 0;font-size:15px;color:#333333;">
                    <strong>Breach ID:</strong> #{{ breach_id }}
                  </td>
                </tr>
              </table>
              <p style="margin:0 0 16px;font-size:15px;color:#555555;line-height:1.6;">
                Log into the WIMS-BFP system to update the affected systems, data scope, and track NPC submission status.
              </p>
              <table cellpadding="0" cellspacing="0" style="margin:0 0 24px;">
                <tr>
                  <td style="background-color:#8B0000;border-radius:4px;padding:12px 32px;text-align:center;">
                    <a href="{{ dashboard_link }}" style="color:#ffffff;font-size:16px;font-weight:bold;text-decoration:none;display:inline-block;">Review Breach in Dashboard</a>
                  </td>
                </tr>
              </table>
              <p style="margin:0;font-size:14px;color:#666666;line-height:1.6;">
                This is a mandatory regulatory notification. Failure to notify the NPC within 72 hours may result in administrative sanctions under RA 10173.
              </p>
            </td>
          </tr>
          <!-- Footer -->
          <tr>
            <td style="background-color:#f9f9f9;padding:24px 32px;text-align:center;">
              <p style="margin:0;font-size:12px;color:#999999;line-height:1.6;">
                Bureau of Fire Protection — WIMS-BFP<br/>
                This is an automated breach notification under RA 10173 (Data Privacy Act of 2012).
              </p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
