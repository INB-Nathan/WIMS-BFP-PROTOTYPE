{# subject: WIMS-BFP Weekly Report — Week of {{ week_range }} #}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WIMS-BFP Weekly Report</title>
</head>
<body style="margin:0;padding:0;background-color:#f4f4f4;font-family:Arial,sans-serif;">
  <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#f4f4f4;padding:24px 16px;">
    <tr>
      <td align="center">
        <table width="600" cellpadding="0" cellspacing="0" style="max-width:600px;width:100%;">
          <!-- Header -->
          <tr>
            <td style="background-color:#8B0000;padding:24px 32px;text-align:center;">
              <p style="margin:0;color:#ffffff;font-size:20px;font-weight:bold;">Bureau of Fire Protection</p>
              <p style="margin:4px 0 0;color:#ffcccc;font-size:14px;">WIMS-BFP Incident Management System</p>
            </td>
          </tr>
          <!-- Body -->
          <tr>
            <td style="background-color:#ffffff;padding:40px 32px;">
              <p style="margin:0 0 4px;font-size:18px;font-weight:bold;color:#8B0000;">Weekly Fire Incident Summary</p>
              <p style="margin:0 0 24px;font-size:14px;color:#666666;">{{ week_range }}</p>
              <hr style="border:none;border-top:1px solid #eeeeee;margin:0 0 24px;">
              <p style="margin:0 0 8px;font-size:48px;font-weight:bold;color:#8B0000;text-align:center;">{{ total_incidents }}</p>
              <p style="margin:0 0 24px;font-size:14px;color:#666666;text-align:center;">Total Incidents Reported</p>
              <hr style="border:none;border-top:1px solid #eeeeee;margin:0 0 24px;">
              <p style="margin:0 0 16px;font-size:16px;color:#333333;line-height:1.6;">
                <strong>Top Performing Region:</strong> {{ top_region }}
              </p>
              <table cellpadding="0" cellspacing="0" style="margin:0 0 24px;">
                <tr>
                  <td style="background-color:#8B0000;border-radius:4px;padding:12px 32px;text-align:center;">
                    <a href="{{ report_link }}" style="color:#ffffff;font-size:16px;font-weight:bold;text-decoration:none;display:inline-block;">View Full Report</a>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          <!-- Footer -->
          <tr>
            <td style="background-color:#f9f9f9;padding:24px 32px;text-align:center;">
              <p style="margin:0;font-size:12px;color:#999999;line-height:1.6;">
                Bureau of Fire Protection — WIMS-BFP<br/>
                This is an automated weekly report. To adjust notification preferences, contact your administrator.
              </p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>